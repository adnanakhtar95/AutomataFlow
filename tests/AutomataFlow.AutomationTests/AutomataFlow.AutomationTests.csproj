<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-only journal, fault injection, fake supervisor and the shared conformance suite (ADR-058). -->
    <Compile Include="..\Shared\AttemptJournalConformance\**\*.cs" Link="Shared\AttemptJournalConformance\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kestrel for the hostile fixture servers; part of the SDK, not a package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AutomataFlow.Automation\AutomataFlow.Automation.csproj" />
    <!-- Phase 5: the real Worker composition and persistence, run in-process against DemoCrm and PostgreSQL. -->
    <ProjectReference Include="..\..\src\AutomataFlow.Infrastructure\AutomataFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AutomataFlow.Worker\AutomataFlow.Worker.csproj" />
    <!-- ADR-027: build-only edge. DemoCrm is launched as a separate process; its assembly is never referenced. -->
    <ProjectReference Include="..\..\src\DemoCrm\DemoCrm.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
