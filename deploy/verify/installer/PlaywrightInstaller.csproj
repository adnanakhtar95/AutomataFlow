<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build-time helper for deploy/verify/Dockerfile only (not part of the solution).
    It references the pinned Microsoft.Playwright package and runs its bundled CLI to install
    Chromium and its OS dependencies. The version is passed in from Directory.Packages.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="$(PlaywrightVersion)" />
  </ItemGroup>
</Project>
