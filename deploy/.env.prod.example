# AutomataFlow production configuration (docs/DEPLOYMENT.md). Copy to deploy/.env.prod (git-ignored) and replace EVERY
# value marked REQUIRED. scripts/new-deployment-secrets.ps1 generates the random values; scripts/validate-deployment.ps1
# refuses placeholders, weak keys and unsafe settings. Never commit deploy/.env.prod.

# --- Database (REQUIRED). Three roles: the bootstrap superuser (init/backup only), the migration owner, the app role.
AF_DB_SUPERUSER_PASSWORD=REQUIRED-change-me
AF_DB_OWNER_PASSWORD=REQUIRED-change-me
AF_DB_APP_PASSWORD=REQUIRED-change-me

# --- Api authentication (REQUIRED): at least 32 random bytes, base64. Rotating it signs every user out.
AF_JWT_SIGNING_KEY=REQUIRED-change-me

# --- Data Protection key ring encryption at rest (REQUIRED, ADR-079): a PKCS#12 certificate file readable only by uid
# 10001 on the host, and its password. Losing either makes stored workspace secrets and sensitive record inputs
# unreadable: back them up separately from the database (docs/DEPLOYMENT.md, "Backup").
AF_KEYRING_CERTIFICATE_FILE=./secrets/keyring.pfx
AF_KEYRING_CERTIFICATE_PASSWORD=REQUIRED-change-me

# --- Images: leave the defaults to build from this repository, or point to your registry (pin by digest).
# AF_API_IMAGE=registry.example.com/automataflow-api@sha256:...
# AF_WORKER_IMAGE=registry.example.com/automataflow-worker@sha256:...
# AF_WEB_IMAGE=registry.example.com/automataflow-web@sha256:...
PLAYWRIGHT_VERSION=1.64.1

# --- Platform
# SelfHosted (one organization or trusted customers) or Hosted (untrusted tenants: see the hosted-mode limitations).
AF_PLATFORM_MODE=SelfHosted
# Self-service sign-up creates new workspaces. Keep false; onboard customers through the platform operator (Phase 8).
AF_ALLOW_REGISTRATION=false
AF_WORKER_CONCURRENCY=2

# --- Network. The gateway listens on AF_HTTP_BIND:AF_HTTP_PORT. Put a TLS terminator in front (profile "tls" below or
# your own); browsers keep the session cookie only over HTTPS.
AF_HTTP_BIND=127.0.0.1
AF_HTTP_PORT=8080
AF_EDGE_SUBNET=172.30.10.0/24
# Number of proxies that add X-Forwarded-For before the Api: 1 = gateway only, 2 = TLS profile + gateway.
AF_PROXY_HOPS=1
# Profile "tls" (Caddy, automatic certificates): your public DNS name and the ACME contact address.
AF_DOMAIN=
AF_ACME_EMAIL=

# --- Resource limits (docs/DEPLOYMENT.md, "Capacity")
AF_DB_CPUS=2
AF_DB_MEMORY=2g
AF_API_CPUS=2
AF_API_MEMORY=1g
AF_WORKER_CPUS=2
AF_WORKER_MEMORY=3g
