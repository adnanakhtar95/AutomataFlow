# Copy this file to deploy/.env (git-ignored) and replace the placeholder values.
# Never commit deploy/.env.
POSTGRES_USER=automataflow
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=automataflow
POSTGRES_HOST_PORT=5433

# Connection string used by the Api, Worker and dotnet-ef when running on the host.
# Export it in your shell, e.g. PowerShell:
#   $env:ConnectionStrings__Default = "Host=localhost;Port=5433;Database=automataflow;Username=automataflow;Password=<POSTGRES_PASSWORD>"

# DemoCrm reset/state control API (docs/DEMO_CRM.md). Leave unset to keep the control API disabled (404).
# Standard .NET mapping: DemoCrm__ControlApi__Token  ->  configuration key DemoCrm:ControlApi:Token.
# scripts/run-demo-crm.ps1 generates a random value per run if this is not set in your shell.
# DemoCrm__ControlApi__Token=
